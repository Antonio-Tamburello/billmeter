# Copy this file to .env and fill in ONLY the providers you want to use.
# .env is in .gitignore: never commit real keys.

# --- Cloud providers ----------------------------------------------------
ANTHROPIC_API_KEY=          # https://console.anthropic.com  -> anthropic:<model>
OPENAI_API_KEY=             # https://platform.openai.com    -> openai:<model>
GEMINI_API_KEY=             # https://aistudio.google.com     -> gemini:<model>
OPENROUTER_API_KEY=         # https://openrouter.ai (hundreds of models with one key) -> openrouter:<vendor/model>
MISTRAL_API_KEY=            # https://console.mistral.ai      -> mistral:<model>

# --- Local models -------------------------------------------------------
# Ollama: no key. Change only if Ollama does not run on this machine.
# OLLAMA_HOST=http://localhost:11434
# LM Studio: start its local server, then use lmstudio:<model>
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Any other OpenAI-compatible server (vLLM, Groq, Together, DeepSeek, ...)
# OPENAI_COMPAT_BASE_URL=https://example.com/v1
# OPENAI_COMPAT_API_KEY=
# Structured output mode for OpenAI-compatible servers: json_schema | json_object | none
# OPENAI_RESPONSE_FORMAT=

# --- Private datasets ---------------------------------------------------
# Secret used to hash sensitive expected values of real bills (billmeter review / billmeter hash).
# Create one with: python -c "import secrets; print(secrets.token_hex(32))"
# Keep it out of git, and don't lose it: without it the stored hashes can't be checked.
# EVAL_HMAC_KEY=
